  "version": "1.0.0",
  "description": "OlymposPass Ekosistemi & LİKYA CEO Paneli",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sync": "bash scripts/dev-sync.sh",
    "search-proxy": "node server/search-proxy.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/prod-server.js",
