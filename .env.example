# HERODOT canlı web araması — isteğe bağlı API anahtarları
# Anahtar yoksa DuckDuckGo HTML araması denenir; o da başarısızsa
# yerleşik istihbarat havuzu (fallback) kullanılır.

# Brave Search API: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# Tavily API: https://tavily.com/
# TAVILY_API_KEY=

# Bağımsız proxy portu (npm run search-proxy)
# SEARCH_PROXY_PORT=8787
